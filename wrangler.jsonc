{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "motobharat-web",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": [
    // Node.js APIs (Buffer, process.env, node: prefixes) — sharp itself is
    // native-only and stays lazy-loaded; see src/lib/media.ts.
    "nodejs_compat",
    // Allow fetch() to public URLs (Supabase, R2, external image URLs).
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "motobharat_assets",
      "bucket_name": "motobharat-assets"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "motobharat-web"
    }
  ],
  // Cloudflare Images binding for next/image optimization.
  // See https://opennext.js.org/cloudflare/howtos/image
  "images": {
    "binding": "IMAGES"
  }
}
