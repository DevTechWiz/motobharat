# Supabase — cloud project (Mumbai region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 — gallery + cover storage (06_MEDIA.md). Leave empty until the bucket exists;
# uploads then fail with "R2 not configured" instead of crashing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read base URL, no trailing slash — e.g. https://pub-<hash>.r2.dev or your custom domain
R2_PUBLIC_BASE_URL=
